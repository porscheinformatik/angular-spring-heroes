{
  "$schema": "node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "heroes-frontend": {
      "root": "heroes-frontend",
      "sourceRoot": "heroes-frontend/src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "heroes-frontend/target/classes/static",
            "index": "heroes-frontend/src/index.html",
            "polyfills": ["zone.js", "heroes-frontend/src/polyfills.ts"],
            "tsConfig": "heroes-frontend/tsconfig.app.json",
            "assets": ["heroes-frontend/src/favicon.ico", "heroes-frontend/src/assets"],
            "styles": [
              "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "heroes-frontend/src/styles.css"
            ],
            "scripts": [],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "heroes-frontend/src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "heroes-frontend/src/environments/environment.ts",
                  "with": "heroes-frontend/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "testing": {
              "aot": false,
              "polyfills": ["zone.js", "zone.js/testing", "heroes-frontend/src/polyfills.ts"]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "heroes-frontend:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "heroes-frontend:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "heroes-frontend:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverage": true,
            "coverageReporters": ["html", "lcovonly"],
            "tsConfig": "heroes-frontend/tsconfig.spec.json",
            "buildTarget": ":build:testing"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "eslint.config.mjs",
            "lintFilePatterns": ["heroes-frontend/src/**/*.ts", "heroes-frontend/src/**/*.html"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
